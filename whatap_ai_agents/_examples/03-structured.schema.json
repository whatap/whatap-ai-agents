{
  "type": "object",
  "required": ["findings"],
  "additionalProperties": false,
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "pii_type", "confidence"],
        "additionalProperties": false,
        "properties": {
          "field": {"type": "string"},
          "pii_type": {
            "type": "string",
            "enum": ["email", "phone", "name", "address", "card", "ssn", "other"]
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
